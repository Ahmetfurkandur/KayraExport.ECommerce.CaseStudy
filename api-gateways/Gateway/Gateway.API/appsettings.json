{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-swagger": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/swagger/auth/v1/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/swagger/v1/{**remainder}" }
        ]
      },
      "auth-register": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "fixed",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/gateway/auth/register" },
        "Transforms": [
          { "PathSet": "/api/Users/register" }
        ]
      },
      "auth-login": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "fixed",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/gateway/auth/login" },
        "Transforms": [
          { "PathSet": "/api/Users/login" }
        ]
      },
      "auth-logout": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "fixed",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/gateway/auth/logout" },
        "Transforms": [
          { "PathSet": "/api/Users/logout" }
        ]
      },
      "auth-refresh": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "fixed",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/gateway/auth/refresh" },
        "Transforms": [
          { "PathSet": "/api/Users/refresh" }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "default": {
            "Address": "http://auth-service:8080"
          }
        }
      }
    }
  }
}
