{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-swagger": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/swagger/auth/v1/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/swagger/v1/{**remainder}" }
        ]
      },
      "product-swagger": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/swagger/product/v1/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/swagger/v1/{**remainder}" }
        ]
      },
      "log-swagger": {
        "ClusterId": "log-cluster",
        "Match": {
          "Path": "/swagger/log/v1/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/swagger/v1/{**remainder}" }
        ]
      },
      "auth-register": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "fixed",
        "Match": { "Path": "/gateway/auth/register" },
        "Transforms": [
          { "PathSet": "/api/v1/Users/register" }
        ]
      },
      "auth-login": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "fixed",
        "Match": { "Path": "/gateway/auth/login" },
        "Transforms": [
          { "PathSet": "/api/v1/Users/login" }
        ]
      },
      "auth-logout": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "fixed",
        "Match": { "Path": "/gateway/auth/logout" },
        "Transforms": [
          { "PathSet": "/api/v1/Users/logout" }
        ]
      },
      "auth-refresh": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "fixed",
        "Match": { "Path": "/gateway/auth/refresh" },
        "Transforms": [
          { "PathSet": "/api/v1/Users/refresh" }
        ]
      },
      "product-create": {
        "ClusterId": "product-cluster",
        "RateLimiterPolicy": "fixed",
        "Match": {
          "Path": "/gateway/products",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathSet": "/api/v1/products" }
        ]
      },
      "product-list": {
        "ClusterId": "product-cluster",
        "RateLimiterPolicy": "fixed",
        "Match": {
          "Path": "/gateway/products",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          { "PathSet": "/api/v1/products" }
        ]
      },
      "product-update": {
        "ClusterId": "product-cluster",
        "RateLimiterPolicy": "fixed",
        "Match": {
          "Path": "/gateway/products/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/gateway" },
          { "PathPrefix": "/api/v1" }
        ]
      },
      "log-events": {
        "ClusterId": "log-cluster",
        "RateLimiterPolicy": "fixed",
        "Match": {
          "Path": "/gateway/logs/events/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/gateway/logs" },
          { "PathPrefix": "/api/v1" }
        ]
      },
      "log-statistics": {
        "ClusterId": "log-cluster",
        "RateLimiterPolicy": "fixed",
        "Match": {
          "Path": "/gateway/logs/statistics/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/gateway/logs" },
          { "PathPrefix": "/api/v1" }
        ]
      },
      "auth-api-catchall": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "fixed",
        "Match": {
          "Path": "/api/v1/Users/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/Users/{**remainder}" }
        ]
      },
      "product-api-catchall": {
        "ClusterId": "product-cluster",
        "RateLimiterPolicy": "fixed",
        "Match": {
          "Path": "/api/v1/products/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/products/{**remainder}" }
        ]
      },
      "log-events-api-catchall": {
        "ClusterId": "log-cluster",
        "RateLimiterPolicy": "fixed",
        "Match": {
          "Path": "/api/v1/events/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/events/{**remainder}" }
        ]
      },
      "log-statistics-api-catchall": {
        "ClusterId": "log-cluster",
        "RateLimiterPolicy": "fixed",
        "Match": {
          "Path": "/api/v1/statistics/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/statistics/{**remainder}" }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "default": {
            "Address": "http://auth-service:8080"
          }
        }
      }
    }
  }
}
