# =============================================================================
# .env.example — Ortam Değişkenleri Şablonu
# =============================================================================
# Bu dosyayı kopyalayarak .env oluşturun:
#   cp .env.example .env
#
# 12FA III (Config): Tüm konfigürasyon ortam değişkenlerinden gelir.
# !!!  .env dosyasını ASLA git'e commit etmeyin!
# .gitignore'a ".env" ekleyin.
# =============================================================================

# -----------------------------------------------------------------------------
# GENEL / ORTAM
# -----------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
IMAGE_TAG=latest
REGISTRY=local

# -----------------------------------------------------------------------------
# API GATEWAY
# -----------------------------------------------------------------------------
GATEWAY_HTTP_PORT=5000
GATEWAY_HTTPS_PORT=5001

# Rate Limiting
RATE_LIMIT_PERMIT=100
RATE_LIMIT_WINDOW=60

# -----------------------------------------------------------------------------
# JWT ( !!! Production'da güçlü ve rastgele bir değer kullanın)
# Minimum 32 karakter, özel karakter içermeli
# Örnek üretme: openssl rand -base64 64
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_USE_STRONG_SECRET_MIN_32_CHARS
JWT_ISSUER=http://auth-service:8080
JWT_AUDIENCE=microservices-app
JWT_ACCESS_EXPIRY_MIN=15
JWT_REFRESH_EXPIRY_DAYS=7

# -----------------------------------------------------------------------------
# SQL SERVER
# !!!  SA parolası için zorunlu kurallar:
#     - En az 8 karakter
#     - Büyük harf, küçük harf, rakam VE özel karakter içermeli
# -----------------------------------------------------------------------------
SQL_PASSWORD=CHANGE_ME_StrongP@ssw0rd!
SQL_USER=sa
SQL_PORT=1433
MSSQL_PID=Developer
MSSQL_MEMORY_LIMIT=2048

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_PORT=6379
REDIS_MAX_MEMORY=256mb
REDIS_DEFAULT_EXPIRY=60

# -----------------------------------------------------------------------------
# RABBITMQ
# -----------------------------------------------------------------------------
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq_password
RABBITMQ_VHOST=/
RABBITMQ_MGMT_PORT=15672

# -----------------------------------------------------------------------------
# SEQ (Structured Logging UI)
# -----------------------------------------------------------------------------
SEQ_ADMIN_PASSWORD=CHANGE_ME_seq_admin_password
SEQ_API_KEY=
SEQ_UI_PORT=8081
